# Local backend configuration. Never commit your real .env file.
APP_ENV=development
DEBUG=true
API_TITLE=SUJAAI API
API_VERSION=0.3.0

# Generate a persistent local key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Use PostgreSQL in production; SQLite is for local development only.
DATABASE_URL=sqlite:///./sujaai.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Initial owner login. Use a unique password with 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Add the exact deployed frontend origin(s), comma-separated, without /api or page paths.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_DESIGN_PAYLOAD_BYTES=6291456
UPLOAD_DIR=uploads
